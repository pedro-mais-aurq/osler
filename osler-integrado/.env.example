# Online mode. Demo mode does not read/use these credentials.
VITE_DATA_MODE=supabase
# / for a custom domain; /osler/ when served under that GitHub Pages path.
VITE_BASE_PATH=/
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibility with projects still using the legacy public anon key:
VITE_SUPABASE_ANON_KEY=
